# ==========================================
# AI-Powered Influencer Outreach Automation
# Environment Configuration
# ==========================================

# Project Mode
# Set DEMO_MODE=True to test without requiring paid API keys
# Set DEMO_MODE=False to use configured live Claude AI; Gmail live sending is controlled by OAuth.
DEMO_MODE=True

# Claude AI (Anthropic) API Key
# Sign up at https://console.anthropic.com/ to obtain an API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Sheets API Configuration
# Place your Google Cloud service account JSON in backend/google_credentials.json
GOOGLE_SHEETS_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Database Configuration
DATABASE_URL=sqlite:///./influencers.db

# Gmail OAuth 2.0 (Phase 2)
# Create an OAuth client (Desktop or Web) in Google Cloud Console
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and secret; changing it makes stored Gmail OAuth tokens unreadable.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gmail/callback
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Outreach safeguards
DAILY_SEND_LIMIT=40
MIN_SECONDS_BETWEEN_SENDS=0.25
FOLLOWUP_1_MIN_DAYS=3
FOLLOWUP_1_MAX_DAYS=5
FOLLOWUP_2_MIN_DAYS=5
FOLLOWUP_2_MAX_DAYS=7
SENDER_NAME=Partnerships Team
